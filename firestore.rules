rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The document as it would exist AFTER the write. Writes use merge:true,
    // so this is the merged result, not just the changed fields.
    function after() { return request.resource.data; }

    // Optional numeric field: either absent, or a number within [lo, hi].
    // Ranges are deliberately generous — they exist to reject impossible
    // values (a scripted client writing 999999 to top a board), not to
    // second-guess legitimate play.
    function num(v, lo, hi) { return v is number && v >= lo && v <= hi; }

    // An hour of the day. `is int` and not num(): a whole-numbered double
    // (19.0) would never equal the integer hour the scheduled function
    // compares against, so it must not be storable in the first place.
    function hourOk(h) { return h is int && h >= 0 && h <= 23; }

    match /users/{userId} {
      allow read: if signedIn() && me() == userId;

      // Deliberately NO hasOnly() field allowlist on this document, unlike
      // /leaderboard below. Two reasons: it would have to list every key in
      // SYNCED_KEYS (js/firebase.js), so it would break silently every time a
      // key is added there — a trap, not a control; and this document is
      // PRIVATE (the read rule above is owner-only), so there is no privacy
      // promise for an allowlist to enforce. What IS constrained is the
      // handful of fields whose value the app depends on being sane, and the
      // two fields the Cloud Functions own.
      allow write: if signedIn() && me() == userId
        // The client may NEVER write the send-history fields. They are the
        // only thing enforcing the two-notifications-a-day ceiling; a client
        // that could set them could silence itself or spam itself. The
        // FUNCTIONS write these with the Admin SDK, which bypasses these rules
        // entirely.
        //
        // resource is NULL on a create, and diff() against a null document
        // errors — which denies the very first write of every new account.
        // That is exactly the trap that stopped anyone deleting live/state for
        // two commits, so the guard comes first and short-circuits.
        && (resource == null
            ? !after().keys().hasAny(['lastNudgeDate', 'lastWarnDate'])
            : !after().diff(resource.data).affectedKeys()
                  .hasAny(['lastNudgeDate', 'lastWarnDate']))
        && (!('remindHourLocal' in after()) || hourOk(after().remindHourLocal))
        && (!('notifyHourUtc'   in after()) || hourOk(after().notifyHourUtc))
        && (!('warnHourUtc'     in after()) || hourOk(after().warnHourUtc))
        && (!('timeZone' in after())
            || (after().timeZone is string && after().timeZone.size() <= 64))
        && (!('notifPrefs' in after())
            || after().notifPrefs.keys().hasOnly(['daily','warn','friends','live']));
    }

    // One document per registered device. A SUBCOLLECTION, because rules do
    // NOT cascade from users/{userId} — without this block nobody could write
    // a token at all. Nothing here is readable by anyone but the owner; the
    // FUNCTIONS read it with the Admin SDK, which does not consult these
    // rules.
    //
    // The token is both the document id AND a field, same as the Masterclass
    // members collection: the id is what the rule can check, the field is what
    // a query can filter on, so they are forced to agree.
    //
    // The 10-tokens-per-user cap is NOT here and cannot be: enforcing it needs
    // a server-maintained counter, and a counter the client can write is not a
    // security control. It is advisory, pruned oldest-first by the client.
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, list, delete: if signedIn() && me() == userId;

      allow create, update: if signedIn() && me() == userId
        && after().keys().hasOnly(['token','createdAt','platform','lang'])
        && after().token is string
        && after().token.size() <= 4096
        && after().token == tokenId
        && after().platform in ['android','ios','desktop','other']
        && after().lang in ['es','en'];
    }

    match /leaderboard/{uid} {
      allow read: if true;

      // Deleting your own entry must be allowed, otherwise account deletion
      // leaves a public profile name on the leaderboard forever — which would
      // contradict the Privacy Policy's deletion promise.
      allow delete: if request.auth != null && request.auth.uid == uid;

      // hasOnly() must mirror PUBLISHED_KEYS in js/firebase.js exactly (plus
      // the two derived averages and updatedAt) — this collection is
      // world-readable, so restricting which fields a client can write here
      // (not just who) is what actually enforces the Privacy Policy's promise
      // that real name/email never go public, independent of whether the
      // client-side code can be trusted.
      allow write: if request.auth != null && request.auth.uid == uid
        && after().keys().hasOnly([
          'profileName', 'username', 'usernameLower',
          'avatarId', 'puzzleElo', 'puzzleThemeElo',
          'openingElo', 'endgameElo', 'streakCount', 'rushBestScore',
          'rushBest180', 'rushBest300',
          'rushMonth180', 'rushMonth300', 'rushMonthKey',
          'blindfoldElo', 'openingEloAvg', 'endgameEloAvg',
          'profileVisibility', 'updatedAt'
        ])

        // Profile privacy. A word rather than a flag, so extra levels can be
        // added without a schema change; anything else is rejected outright so
        // a typo can't silently read as "public" downstream.
        && (!('profileVisibility' in after()) ||
            after().profileVisibility in ['public', 'private'])

        // The privacy guarantee itself, enforced here rather than trusted to
        // the client: a private profile may not carry the detail fields at
        // all. Not publishing them is what makes them private — the UI hiding
        // them would mean nothing on a world-readable document.
        && (after().get('profileVisibility', 'public') == 'public' ||
            !after().keys().hasAny(['puzzleThemeElo', 'openingElo', 'endgameElo', 'streakCount']))

        // Text fields: bounded length so the public doc can't be used as
        // free storage or to inject an oversized display name.
        && (!('profileName' in after()) ||
            (after().profileName is string && after().profileName.size() <= 60))
        && (!('username' in after()) ||
            (after().username is string && after().username.size() <= 60))
        // usernameLower is username.toLowerCase(), published so that friend
        // search can match without case. Same bound as the field it derives
        // from; it is not checked to actually BE the lowercase form, because
        // nothing is granted by it — it only decides whether search finds you.
        && (!('usernameLower' in after()) ||
            (after().usernameLower is string && after().usernameLower.size() <= 60))
        && (!('avatarId' in after()) ||
            (after().avatarId is string && after().avatarId.size() <= 64))

        // Ranked scalars — these are what the boards sort on, so they are the
        // only fields worth forging. Everything here is range-checked.
        && (!('puzzleElo' in after())    || num(after().puzzleElo, 0, 4000))
        && (!('blindfoldElo' in after()) || num(after().blindfoldElo, 0, 4000))
        && (!('openingEloAvg' in after())|| num(after().openingEloAvg, 0, 4000))
        && (!('endgameEloAvg' in after())|| num(after().endgameEloAvg, 0, 4000))
        && (!('rushBestScore' in after())|| num(after().rushBestScore, 0, 1000))
        && (!('rushBest180' in after())  || num(after().rushBest180, 0, 1000))
        && (!('rushBest300' in after())  || num(after().rushBest300, 0, 1000))
        && (!('rushMonth180' in after()) || num(after().rushMonth180, 0, 1000))
        && (!('rushMonth300' in after()) || num(after().rushMonth300, 0, 1000))
        && (!('rushMonthKey' in after()) ||
            (after().rushMonthKey is string && after().rushMonthKey.size() <= 7))
        && (!('streakCount' in after())  || num(after().streakCount, 0, 30000))
        && (!('updatedAt' in after())    || after().updatedAt is number)

        // Per-theme / per-opening rating maps. No board sorts on these, so
        // shape-checking is enough; Firestore's own 1 MB document cap bounds
        // the size.
        && (!('puzzleThemeElo' in after()) || after().puzzleThemeElo is map)
        && (!('openingElo' in after())     || after().openingElo is map)
        && (!('endgameElo' in after())     || after().endgameElo is map);
    }

    // ══════════════════════════ Friends ══════════════════════════
    // Everything above rests on one simple property: you only ever write your
    // own document. These three collections BREAK that property — a friend
    // request is a document one person creates that then renders on another
    // person's screen, and a friendship document is trusted to mean "this
    // person is my friend". So every clause here is spelled out, and every one
    // of them is covered by a test in tests/rules/friends.test.js.

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // A friendship id is the two uids sorted and joined with "_", so a pair can
    // only ever have one document and either side can work out its id without
    // looking anything up.
    function pairIdOk(pairId, m) {
      return m.size() == 2
        && m[0] is string && m[1] is string
        && m[0] < m[1]
        && pairId == m[0] + '_' + m[1];
    }

    match /friendships/{pairId} {
      // Only the two people in it can read it. This is also what makes the
      // "list my friends" query — where('members','array-contains',myUid) —
      // safe: any broader query is rejected.
      allow read: if signedIn() && me() in resource.data.members;

      // You may only create a friendship the OTHER person asked for: their
      // pending request has to still exist at this moment. That is the clause
      // that stops anyone writing themselves into a stranger's friends list.
      allow create: if signedIn()
        && after().keys().hasOnly(['members', 'createdAt'])
        && after().createdAt is number
        && pairIdOk(pairId, after().members)
        && me() in after().members
        && exists(/databases/$(database)/documents/friendRequests/$(
             (after().members[0] == me() ? after().members[1] : after().members[0])
             + '_' + me()));

      // A friendship is created or deleted, never edited.
      allow update: if false;

      // Either side can unfriend, on their own, with no notification.
      allow delete: if signedIn() && me() in resource.data.members;
    }

    match /friendRequests/{reqId} {
      // get() and .get(field, default) are not the same thing, and the second
      // one is load-bearing here. On a LIST query Firestore evaluates this
      // against a resource assembled from the query's own constraints, not
      // from a stored document — so in the incoming query (to == me) the
      // "from" field does not exist at all, and reading it directly makes the
      // whole rule error out and deny. Defaulting to '' lets each of the app's
      // two queries pass on the field it actually constrained, while a query
      // that constrains neither still gets nothing.
      allow read: if signedIn()
        && (resource.data.get('from', '') == me()
            || resource.data.get('to', '') == me());

      allow create: if signedIn()
        && after().keys().hasOnly(['from', 'to', 'status', 'createdAt'])
        && after().from == me()
        && after().to is string && after().to.size() <= 128
        && after().to != me()
        // Deterministic id: a second request to the same person is the same
        // document, so nobody can be spammed with repeats.
        && reqId == after().from + '_' + after().to
        && after().status == 'pending'
        && after().createdAt is number
        // Blocking is silent by design. A blocked sender gets a plain
        // permission error and is never told a block exists — the app shows
        // them the ordinary "Request sent" toast. Do not "improve" this.
        && !exists(/databases/$(database)/documents/blocks/$(after().to)/blocked/$(me()));

      // Only the recipient may reject, only to 'rejected', and nothing else on
      // the document may move. So a turned-down request cannot be flipped back
      // to pending by the sender asking again — one rejection is permanent and
      // silent.
      allow update: if signedIn()
        && me() == resource.data.to
        && after().keys().hasOnly(['from', 'to', 'status', 'createdAt'])
        && after().status == 'rejected'
        && after().from == resource.data.from
        && after().to == resource.data.to
        && after().createdAt == resource.data.createdAt;

      // The sender cancelling, the recipient clearing a rejection, or either
      // side tidying up after an accept.
      allow delete: if signedIn() && me() in [resource.data.from, resource.data.to];
    }

    // My own block list. Nobody else can read it, so a blocked person cannot
    // find out they were blocked by looking.
    match /blocks/{uid}/blocked/{other} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ═══════════════════════ Masterclass ═══════════════════════
    // A Masterclass is a shared base that lives here rather than in the
    // device's IndexedDB. Unlike /leaderboard, NOTHING here is world-readable:
    // `allow list` is false on the class collection, so the ids cannot even be
    // enumerated, and every read needs a membership document.
    //
    // Membership is a SUBCOLLECTION with a role STRING, deliberately:
    //   - a subcollection (not a roles map on the parent) is what will let a
    //     link-invited stranger create their OWN membership in stage 2 without
    //     writing the owner's document;
    //   - a string (not isOwner: true) means 'editor' is already a legal stored
    //     value, so stage 2 grants it by changing three clauses below and
    //     changes no stored data at all.
    // Do not "simplify" either one.
    //
    // Every clause here is covered by a test in tests/rules/masterclass.test.js.

    function mcPath(mcId) {
      return /databases/$(database)/documents/masterclasses/$(mcId);
    }

    // Admin decisions key off the PARENT document's ownerUid, not off a member
    // document. That dodges a bootstrap problem: the owner has to create their
    // own member document, and a rule asking "are you already an owner-member?"
    // could never let the first one through.
    function mcOwnerUid(mcId) {
      return get(mcPath(mcId)).data.ownerUid;
    }
    function mcIsOwner(mcId) {
      return signedIn() && mcOwnerUid(mcId) == me();
    }
    function mcIsMember(mcId) {
      return signedIn() && exists(/databases/$(database)/documents/masterclasses/$(mcId)/members/$(me()));
    }
    // get() results are cached per request for identical paths, so mcIsOwner()
    // and mcIsMember() together cost ONE document read, not two per call.

    match /masterclasses/{mcId} {
      // get only. `list` stays false so the collection cannot be enumerated —
      // this is the opposite of /leaderboard and it is deliberate.
      allow get: if signedIn()
        && (resource.data.ownerUid == me() || mcIsMember(mcId));
      allow list: if false;

      allow create: if signedIn()
        && after().keys().hasOnly(['ownerUid', 'name', 'createdAt', 'updatedAt', 'memberCount'])
        && after().ownerUid == me()
        && after().name is string && after().name.size() > 0 && after().name.size() <= 60
        && after().createdAt == request.time
        && after().updatedAt == request.time
        && after().memberCount is int;

      // ownerUid is immutable: transferring a class is not a feature, and
      // letting it move would let an owner hand off a class full of somebody
      // else's work.
      allow update: if signedIn()
        && resource.data.ownerUid == me()
        && after().ownerUid == resource.data.ownerUid
        && after().keys().hasOnly(['ownerUid', 'name', 'createdAt', 'updatedAt', 'memberCount'])
        && after().name is string && after().name.size() > 0 && after().name.size() <= 60
        && after().createdAt == resource.data.createdAt
        && after().updatedAt == request.time
        && after().memberCount is int;

      // Firestore does NOT cascade. Deleting this document leaves members and
      // chapters behind forever, so the client deletes them first — see the
      // deleteMasterclass() comment in js/firebase.js.
      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    match /masterclasses/{mcId}/members/{memberUid} {
      // Anyone in the class can see who else is in it.
      allow read: if mcIsMember(mcId) || mcIsOwner(mcId);

      // Stage 1: only the owner adds people, and only someone who has not
      // blocked them. Stage 2 adds a second create path for link invites —
      // it is an extra `||` branch here, nothing above changes.
      allow create: if mcIsOwner(mcId)
        && after().keys().hasOnly(['uid', 'role', 'addedBy', 'addedAt'])
        && after().uid == memberUid
        && after().role in ['owner', 'editor', 'viewer']
        && after().addedBy == me()
        && after().addedAt == request.time
        && !exists(/databases/$(database)/documents/blocks/$(memberUid)/blocked/$(me()));

      // A role is granted or revoked, never edited in place. Changing somebody
      // from viewer to editor is a delete plus a create, so there is exactly
      // one code path that hands out a role.
      allow update: if false;

      // Either the owner removing someone, or a member leaving on their own.
      // The owner may NOT delete their own membership WHILE THE CLASS EXISTS —
      // that would leave a class nobody can read.
      //
      // The first clause is the one that closes deleteMasterclass()'s leak.
      // That function deletes the subcollections, then the parent, and only
      // then its own membership; before this clause existed that last delete
      // was refused twice over — clause three is false for the owner while the
      // class is there, and once the parent is gone mcOwnerUid() calls get() on
      // a document that does not exist and the null dereference ERRORS. So one
      // document survived every delete: the owner's own membership.
      //
      // Order is not cosmetic. `||` is evaluated left to right and an error in
      // an earlier clause denies the whole rule, so the clause that does NOT
      // touch the missing parent has to come first — putting it last would
      // leave it unreachable in exactly the case it exists for.
      //
      // It is safe because of `memberUid == me()`: it can only ever delete your
      // own document, it is unreachable while the class exists, and a document
      // whose parent is gone is unreadable by anybody else anyway (both read
      // rules need the parent) and holds nothing but your own uid and role.
      allow delete: if (signedIn() && memberUid == me() && !exists(mcPath(mcId)))
        || (mcIsOwner(mcId) && memberUid != me())
        || (signedIn() && memberUid == me() && mcOwnerUid(mcId) != me());
    }

    // Serves the collection-group query fetchMyMasterclasses() runs:
    //   collectionGroup('members').where('uid','==',me)
    // A collection-group query is NOT matched by the path-specific rule above,
    // so it needs its own match.
    //
    // It checks the uid FIELD, not the {memberUid} document id, and that is not
    // a style choice: on a collection-group LIST the id wildcard is not bound to
    // anything, so reading it raises "Null value error" and denies the query.
    // (The plan's draft of this rule used the id and failed test 24 for exactly
    // that reason.) This is what the redundant `uid` field on every member
    // document is FOR — do not delete it as duplication.
    //
    // The wildcard is still safe: the clause is unprovable unless the query
    // itself constrains uid == my own uid, so an unfiltered collection-group
    // read, or one asking for somebody else's uid, is refused outright. And the
    // create rule forces uid == the document id, so the field cannot be pointed
    // at a document it does not name.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    match /masterclasses/{mcId}/chapters/{chapterId} {
      allow read: if mcIsMember(mcId) || mcIsOwner(mcId);

      // STAGE 2: this becomes `mcIsOwner(mcId) || mcRole(mcId) == 'editor'`.
      // That is the whole change — the stored shape does not move.
      allow write: if mcIsOwner(mcId)
        && after().keys().hasOnly(['title', 'pgn', 'startFen', 'order', 'updatedAt', 'updatedBy'])
        && after().title is string && after().title.size() <= 80
        // The real anti-abuse bound. The 50-chapter and 30-member caps in the
        // UI are advisory and cannot be enforced here; this one can.
        && after().pgn is string && after().pgn.size() <= 100000
        && after().startFen is string && after().startFen.size() <= 100
        && after().order is number
        && after().updatedBy == me()
        && after().updatedAt == request.time;

      allow delete: if mcIsOwner(mcId);
    }

    // Exactly one document, id 'state'. Any other id is refused so this cannot
    // quietly become a second content store.
    match /masterclasses/{mcId}/live/{docId} {
      allow read: if mcIsMember(mcId) || mcIsOwner(mcId);

      // STAGE 2: this becomes `mcIsOwner(mcId) || mcRole(mcId) == 'editor'`.
      allow write: if docId == 'state'
        && mcIsOwner(mcId)
        && after().keys().hasOnly(['chapterId', 'fen', 'line', 'drivenBy', 'updatedAt'])
        && (after().chapterId == null || (after().chapterId is string && after().chapterId.size() <= 64))
        && after().fen is string && after().fen.size() <= 100
        // `line` is the teacher's moves in SAN, not a pointer into the stored
        // chapter: moves played during a lesson are never saved to the chapter,
        // so a pointer names a node the follower does not have. See BUG A.
        // 4096 characters is roughly 800 half-moves — the cap bounds abuse, not
        // size; against the 1 MB document limit it is a rounding error.
        && after().line is string && after().line.size() <= 4096
        && after().drivenBy == me()
        && after().updatedAt == request.time;

      // A delete is NOT covered by the `allow write` above, and this is the
      // trap: every clause up there reads after(), i.e. request.resource.data,
      // which is NULL on a delete. The rule errors and denies, so until this
      // clause landed NOBODY could remove live/state — not even the owner.
      // deleteMasterclass() in js/firebase.js has been attempting it (quietly,
      // outside the batch) since commit 3, and stopping a broadcast deletes it
      // too, so viewers see the class go off air. Two real callers, not tidying.
      allow delete: if mcIsOwner(mcId);
    }
  }
}
