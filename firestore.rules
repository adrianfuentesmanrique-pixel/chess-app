rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The document as it would exist AFTER the write. Writes use merge:true,
    // so this is the merged result, not just the changed fields.
    function after() { return request.resource.data; }

    // Optional numeric field: either absent, or a number within [lo, hi].
    // Ranges are deliberately generous — they exist to reject impossible
    // values (a scripted client writing 999999 to top a board), not to
    // second-guess legitimate play.
    function num(v, lo, hi) { return v is number && v >= lo && v <= hi; }

    // An hour of the day. `is int` and not num(): a whole-numbered double
    // (19.0) would never equal the integer hour the scheduled function
    // compares against, so it must not be storable in the first place.
    function hourOk(h) { return h is int && h >= 0 && h <= 23; }

    match /users/{userId} {
      allow read: if signedIn() && me() == userId;

      // Deliberately NO hasOnly() field allowlist on this document, unlike
      // /leaderboard below. Two reasons: it would have to list every key in
      // SYNCED_KEYS (js/firebase.js), so it would break silently every time a
      // key is added there — a trap, not a control; and this document is
      // PRIVATE (the read rule above is owner-only), so there is no privacy
      // promise for an allowlist to enforce. What IS constrained is the
      // handful of fields whose value the app depends on being sane, and the
      // two fields the Cloud Functions own.
      allow write: if signedIn() && me() == userId
        // The client may NEVER write the send-history fields. They are the
        // only thing enforcing the two-notifications-a-day ceiling; a client
        // that could set them could silence itself or spam itself. The
        // FUNCTIONS write these with the Admin SDK, which bypasses these rules
        // entirely.
        //
        // resource is NULL on a create, and diff() against a null document
        // errors — which denies the very first write of every new account.
        // That is exactly the trap that stopped anyone deleting live/state for
        // two commits, so the guard comes first and short-circuits.
        && (resource == null
            ? !after().keys().hasAny(['lastNudgeDate', 'lastWarnDate'])
            : !after().diff(resource.data).affectedKeys()
                  .hasAny(['lastNudgeDate', 'lastWarnDate']))
        && (!('remindHourLocal' in after()) || hourOk(after().remindHourLocal))
        && (!('notifyHourUtc'   in after()) || hourOk(after().notifyHourUtc))
        && (!('warnHourUtc'     in after()) || hourOk(after().warnHourUtc))
        && (!('timeZone' in after())
            || (after().timeZone is string && after().timeZone.size() <= 64))
        && (!('notifPrefs' in after())
            || after().notifPrefs.keys().hasOnly(['daily','warn','friends','live']));
    }

    // One document per registered device. A SUBCOLLECTION, because rules do
    // NOT cascade from users/{userId} — without this block nobody could write
    // a token at all. Nothing here is readable by anyone but the owner; the
    // FUNCTIONS read it with the Admin SDK, which does not consult these
    // rules.
    //
    // The token is both the document id AND a field, same as the Masterclass
    // members collection: the id is what the rule can check, the field is what
    // a query can filter on, so they are forced to agree.
    //
    // The 10-tokens-per-user cap is NOT here and cannot be: enforcing it needs
    // a server-maintained counter, and a counter the client can write is not a
    // security control. It is advisory, pruned oldest-first by the client.
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, list, delete: if signedIn() && me() == userId;

      allow create, update: if signedIn() && me() == userId
        && after().keys().hasOnly(['token','createdAt','platform','lang'])
        && after().token is string
        && after().token.size() <= 4096
        && after().token == tokenId
        && after().platform in ['android','ios','desktop','other']
        && after().lang in ['es','en'];
    }

    match /leaderboard/{uid} {
      allow read: if true;

      // Deleting your own entry must be allowed, otherwise account deletion
      // leaves a public profile name on the leaderboard forever — which would
      // contradict the Privacy Policy's deletion promise.
      allow delete: if request.auth != null && request.auth.uid == uid;

      // hasOnly() must mirror PUBLISHED_KEYS in js/firebase.js exactly (plus
      // the two derived averages and updatedAt) — this collection is
      // world-readable, so restricting which fields a client can write here
      // (not just who) is what actually enforces the Privacy Policy's promise
      // that real name/email never go public, independent of whether the
      // client-side code can be trusted.
      allow write: if request.auth != null && request.auth.uid == uid
        && after().keys().hasOnly([
          'profileName', 'username', 'usernameLower',
          'avatarId', 'puzzleElo', 'puzzleThemeElo',
          'openingElo', 'endgameElo', 'streakCount', 'rushBestScore',
          'rushBest180', 'rushBest300',
          'rushMonth180', 'rushMonth300', 'rushMonthKey',
          'blindfoldElo', 'openingEloAvg', 'endgameEloAvg',
          'profileVisibility', 'updatedAt'
        ])

        // Profile privacy. A word rather than a flag, so extra levels can be
        // added without a schema change; anything else is rejected outright so
        // a typo can't silently read as "public" downstream.
        && (!('profileVisibility' in after()) ||
            after().profileVisibility in ['public', 'private'])

        // The privacy guarantee itself, enforced here rather than trusted to
        // the client: a private profile may not carry the detail fields at
        // all. Not publishing them is what makes them private — the UI hiding
        // them would mean nothing on a world-readable document.
        && (after().get('profileVisibility', 'public') == 'public' ||
            !after().keys().hasAny(['puzzleThemeElo', 'openingElo', 'endgameElo', 'streakCount']))

        // Text fields: bounded length so the public doc can't be used as
        // free storage or to inject an oversized display name.
        && (!('profileName' in after()) ||
            (after().profileName is string && after().profileName.size() <= 60))
        && (!('username' in after()) ||
            (after().username is string && after().username.size() <= 60))
        // usernameLower is username.toLowerCase(), published so that friend
        // search can match without case. Same bound as the field it derives
        // from; it is not checked to actually BE the lowercase form, because
        // nothing is granted by it — it only decides whether search finds you.
        && (!('usernameLower' in after()) ||
            (after().usernameLower is string && after().usernameLower.size() <= 60))
        && (!('avatarId' in after()) ||
            (after().avatarId is string && after().avatarId.size() <= 64))

        // Ranked scalars — these are what the boards sort on, so they are the
        // only fields worth forging. Everything here is range-checked.
        && (!('puzzleElo' in after())    || num(after().puzzleElo, 0, 4000))
        && (!('blindfoldElo' in after()) || num(after().blindfoldElo, 0, 4000))
        && (!('openingEloAvg' in after())|| num(after().openingEloAvg, 0, 4000))
        && (!('endgameEloAvg' in after())|| num(after().endgameEloAvg, 0, 4000))
        && (!('rushBestScore' in after())|| num(after().rushBestScore, 0, 1000))
        && (!('rushBest180' in after())  || num(after().rushBest180, 0, 1000))
        && (!('rushBest300' in after())  || num(after().rushBest300, 0, 1000))
        && (!('rushMonth180' in after()) || num(after().rushMonth180, 0, 1000))
        && (!('rushMonth300' in after()) || num(after().rushMonth300, 0, 1000))
        && (!('rushMonthKey' in after()) ||
            (after().rushMonthKey is string && after().rushMonthKey.size() <= 7))
        && (!('streakCount' in after())  || num(after().streakCount, 0, 30000))
        && (!('updatedAt' in after())    || after().updatedAt is number)

        // Per-theme / per-opening rating maps. No board sorts on these, so
        // shape-checking is enough; Firestore's own 1 MB document cap bounds
        // the size.
        && (!('puzzleThemeElo' in after()) || after().puzzleThemeElo is map)
        && (!('openingElo' in after())     || after().openingElo is map)
        && (!('endgameElo' in after())     || after().endgameElo is map);
    }

    // ══════════════════════════ Friends ══════════════════════════
    // Everything above rests on one simple property: you only ever write your
    // own document. These three collections BREAK that property — a friend
    // request is a document one person creates that then renders on another
    // person's screen, and a friendship document is trusted to mean "this
    // person is my friend". So every clause here is spelled out, and every one
    // of them is covered by a test in tests/rules/friends.test.js.

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // A friendship id is the two uids sorted and joined with "_", so a pair can
    // only ever have one document and either side can work out its id without
    // looking anything up.
    function pairIdOk(pairId, m) {
      return m.size() == 2
        && m[0] is string && m[1] is string
        && m[0] < m[1]
        && pairId == m[0] + '_' + m[1];
    }

    match /friendships/{pairId} {
      // Only the two people in it can read it. This is also what makes the
      // "list my friends" query — where('members','array-contains',myUid) —
      // safe: any broader query is rejected.
      allow read: if signedIn() && me() in resource.data.members;

      // You may only create a friendship the OTHER person asked for: their
      // pending request has to still exist at this moment. That is the clause
      // that stops anyone writing themselves into a stranger's friends list.
      allow create: if signedIn()
        && after().keys().hasOnly(['members', 'createdAt'])
        && after().createdAt is number
        && pairIdOk(pairId, after().members)
        && me() in after().members
        && exists(/databases/$(database)/documents/friendRequests/$(
             (after().members[0] == me() ? after().members[1] : after().members[0])
             + '_' + me()));

      // A friendship is created or deleted, never edited.
      allow update: if false;

      // Either side can unfriend, on their own, with no notification.
      allow delete: if signedIn() && me() in resource.data.members;
    }

    match /friendRequests/{reqId} {
      // get() and .get(field, default) are not the same thing, and the second
      // one is load-bearing here. On a LIST query Firestore evaluates this
      // against a resource assembled from the query's own constraints, not
      // from a stored document — so in the incoming query (to == me) the
      // "from" field does not exist at all, and reading it directly makes the
      // whole rule error out and deny. Defaulting to '' lets each of the app's
      // two queries pass on the field it actually constrained, while a query
      // that constrains neither still gets nothing.
      allow read: if signedIn()
        && (resource.data.get('from', '') == me()
            || resource.data.get('to', '') == me());

      allow create: if signedIn()
        && after().keys().hasOnly(['from', 'to', 'status', 'createdAt'])
        && after().from == me()
        && after().to is string && after().to.size() <= 128
        && after().to != me()
        // Deterministic id: a second request to the same person is the same
        // document, so nobody can be spammed with repeats.
        && reqId == after().from + '_' + after().to
        && after().status == 'pending'
        && after().createdAt is number
        // Blocking is silent by design. A blocked sender gets a plain
        // permission error and is never told a block exists — the app shows
        // them the ordinary "Request sent" toast. Do not "improve" this.
        && !exists(/databases/$(database)/documents/blocks/$(after().to)/blocked/$(me()));

      // Only the recipient may reject, only to 'rejected', and nothing else on
      // the document may move. So a turned-down request cannot be flipped back
      // to pending by the sender asking again — one rejection is permanent and
      // silent.
      allow update: if signedIn()
        && me() == resource.data.to
        && after().keys().hasOnly(['from', 'to', 'status', 'createdAt'])
        && after().status == 'rejected'
        && after().from == resource.data.from
        && after().to == resource.data.to
        && after().createdAt == resource.data.createdAt;

      // The sender cancelling, the recipient clearing a rejection, or either
      // side tidying up after an accept.
      allow delete: if signedIn() && me() in [resource.data.from, resource.data.to];
    }

    // My own block list. Nobody else can read it, so a blocked person cannot
    // find out they were blocked by looking.
    match /blocks/{uid}/blocked/{other} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ═══════════════════════ Masterclass ═══════════════════════
    // A Masterclass is a shared base that lives here rather than in the
    // device's IndexedDB. Unlike /leaderboard, NOTHING here is world-readable:
    // `allow list` is false on the class collection, so the ids cannot even be
    // enumerated, and every read needs a membership document.
    //
    // Membership is a SUBCOLLECTION with a role STRING, deliberately:
    //   - a subcollection (not a roles map on the parent) is what will let a
    //     link-invited stranger create their OWN membership in stage 2 without
    //     writing the owner's document;
    //   - a string (not isOwner: true) means 'editor' is already a legal stored
    //     value, so stage 2 grants it by changing three clauses below and
    //     changes no stored data at all.
    // Do not "simplify" either one.
    //
    // Every clause here is covered by a test in tests/rules/masterclass.test.js.

    function mcPath(mcId) {
      return /databases/$(database)/documents/masterclasses/$(mcId);
    }

    // Admin decisions key off the PARENT document's ownerUid, not off a member
    // document. That dodges a bootstrap problem: the owner has to create their
    // own member document, and a rule asking "are you already an owner-member?"
    // could never let the first one through.
    function mcOwnerUid(mcId) {
      return get(mcPath(mcId)).data.ownerUid;
    }
    function mcIsOwner(mcId) {
      return signedIn() && mcOwnerUid(mcId) == me();
    }
    function mcIsMember(mcId) {
      return signedIn() && exists(/databases/$(database)/documents/masterclasses/$(mcId)/members/$(me()));
    }
    // get() results are cached per request for identical paths, so mcIsOwner()
    // and mcIsMember() together cost ONE document read, not two per call.

    match /masterclasses/{mcId} {
      // get only. `list` stays false so the collection cannot be enumerated —
      // this is the opposite of /leaderboard and it is deliberate.
      allow get: if signedIn()
        && (resource.data.ownerUid == me() || mcIsMember(mcId));
      allow list: if false;

      allow create: if signedIn()
        && after().keys().hasOnly(['ownerUid', 'name', 'createdAt', 'updatedAt', 'memberCount'])
        && after().ownerUid == me()
        && after().name is string && after().name.size() > 0 && after().name.size() <= 60
        && after().createdAt == request.time
        && after().updatedAt == request.time
        && after().memberCount is int;

      // ownerUid is immutable: transferring a class is not a feature, and
      // letting it move would let an owner hand off a class full of somebody
      // else's work.
      allow update: if signedIn()
        && resource.data.ownerUid == me()
        && after().ownerUid == resource.data.ownerUid
        && after().keys().hasOnly(['ownerUid', 'name', 'createdAt', 'updatedAt', 'memberCount'])
        && after().name is string && after().name.size() > 0 && after().name.size() <= 60
        && after().createdAt == resource.data.createdAt
        && after().updatedAt == request.time
        && after().memberCount is int;

      // Firestore does NOT cascade. Deleting this document leaves members and
      // chapters behind forever, so the client deletes them first — see the
      // deleteMasterclass() comment in js/firebase.js.
      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    match /masterclasses/{mcId}/members/{memberUid} {
      // Anyone in the class can see who else is in it.
      allow read: if mcIsMember(mcId) || mcIsOwner(mcId);

      // Stage 1: only the owner adds people, and only someone who has not
      // blocked them. Stage 2 adds a second create path for link invites —
      // it is an extra `||` branch here, nothing above changes.
      allow create: if mcIsOwner(mcId)
        && after().keys().hasOnly(['uid', 'role', 'addedBy', 'addedAt'])
        && after().uid == memberUid
        && after().role in ['owner', 'editor', 'viewer']
        && after().addedBy == me()
        && after().addedAt == request.time
        && !exists(/databases/$(database)/documents/blocks/$(memberUid)/blocked/$(me()));

      // A role is granted or revoked, never edited in place. Changing somebody
      // from viewer to editor is a delete plus a create, so there is exactly
      // one code path that hands out a role.
      allow update: if false;

      // Either the owner removing someone, or a member leaving on their own.
      // The owner may NOT delete their own membership WHILE THE CLASS EXISTS —
      // that would leave a class nobody can read.
      //
      // The first clause is the one that closes deleteMasterclass()'s leak.
      // That function deletes the subcollections, then the parent, and only
      // then its own membership; before this clause existed that last delete
      // was refused twice over — clause three is false for the owner while the
      // class is there, and once the parent is gone mcOwnerUid() calls get() on
      // a document that does not exist and the null dereference ERRORS. So one
      // document survived every delete: the owner's own membership.
      //
      // Order is not cosmetic. `||` is evaluated left to right and an error in
      // an earlier clause denies the whole rule, so the clause that does NOT
      // touch the missing parent has to come first — putting it last would
      // leave it unreachable in exactly the case it exists for.
      //
      // It is safe because of `memberUid == me()`: it can only ever delete your
      // own document, it is unreachable while the class exists, and a document
      // whose parent is gone is unreadable by anybody else anyway (both read
      // rules need the parent) and holds nothing but your own uid and role.
      allow delete: if (signedIn() && memberUid == me() && !exists(mcPath(mcId)))
        || (mcIsOwner(mcId) && memberUid != me())
        || (signedIn() && memberUid == me() && mcOwnerUid(mcId) != me());
    }

    // Serves the collection-group query fetchMyMasterclasses() runs:
    //   collectionGroup('members').where('uid','==',me)
    // A collection-group query is NOT matched by the path-specific rule above,
    // so it needs its own match.
    //
    // It checks the uid FIELD, not the {memberUid} document id, and that is not
    // a style choice: on a collection-group LIST the id wildcard is not bound to
    // anything, so reading it raises "Null value error" and denies the query.
    // (The plan's draft of this rule used the id and failed test 24 for exactly
    // that reason.) This is what the redundant `uid` field on every member
    // document is FOR — do not delete it as duplication.
    //
    // The wildcard is still safe: the clause is unprovable unless the query
    // itself constrains uid == my own uid, so an unfiltered collection-group
    // read, or one asking for somebody else's uid, is refused outright. And the
    // create rule forces uid == the document id, so the field cannot be pointed
    // at a document it does not name.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    match /masterclasses/{mcId}/chapters/{chapterId} {
      allow read: if mcIsMember(mcId) || mcIsOwner(mcId);

      // STAGE 2: this becomes `mcIsOwner(mcId) || mcRole(mcId) == 'editor'`.
      // That is the whole change — the stored shape does not move.
      allow write: if mcIsOwner(mcId)
        && after().keys().hasOnly(['title', 'pgn', 'startFen', 'order', 'updatedAt', 'updatedBy'])
        && after().title is string && after().title.size() <= 80
        // The real anti-abuse bound. The 50-chapter and 30-member caps in the
        // UI are advisory and cannot be enforced here; this one can.
        && after().pgn is string && after().pgn.size() <= 100000
        && after().startFen is string && after().startFen.size() <= 100
        && after().order is number
        && after().updatedBy == me()
        && after().updatedAt == request.time;

      allow delete: if mcIsOwner(mcId);
    }

    // Exactly one document, id 'state'. Any other id is refused so this cannot
    // quietly become a second content store.
    match /masterclasses/{mcId}/live/{docId} {
      allow read: if mcIsMember(mcId) || mcIsOwner(mcId);

      // STAGE 2: this becomes `mcIsOwner(mcId) || mcRole(mcId) == 'editor'`.
      allow write: if docId == 'state'
        && mcIsOwner(mcId)
        && after().keys().hasOnly(['chapterId', 'fen', 'line', 'shapes', 'drivenBy', 'updatedAt'])
        && (after().chapterId == null || (after().chapterId is string && after().chapterId.size() <= 64))
        && after().fen is string && after().fen.size() <= 100
        // `line` is the teacher's moves in SAN, not a pointer into the stored
        // chapter: moves played during a lesson are never saved to the chapter,
        // so a pointer names a node the follower does not have. See BUG A.
        // 4096 characters is roughly 800 half-moves — the cap bounds abuse, not
        // size; against the 1 MB document limit it is a rounding error.
        && after().line is string && after().line.size() <= 4096
        // The teacher's arrows and highlighted squares on the current
        // position, packed by packShapes() in js/masterclass.js: `a` is
        // colour+from+to per arrow ("Ge2e4"), `s` colour+square ("Rd4"), no
        // separators. The regex is the cap — at most 32 of each, only the three
        // colours the board draws, only real squares. Optional, because a
        // client cached from before arrows were broadcast still writes without
        // it, and its followers simply see no arrows.
        && (!('shapes' in after()) || (after().shapes is map
          && after().shapes.keys().hasOnly(['a', 's'])
          && after().shapes.keys().hasAll(['a', 's'])
          && after().shapes.a is string
          && after().shapes.a.matches('([GYR][a-h][1-8][a-h][1-8]){0,32}')
          && after().shapes.s is string
          && after().shapes.s.matches('([GYR][a-h][1-8]){0,32}')))
        && after().drivenBy == me()
        && after().updatedAt == request.time;

      // A delete is NOT covered by the `allow write` above, and this is the
      // trap: every clause up there reads after(), i.e. request.resource.data,
      // which is NULL on a delete. The rule errors and denies, so until this
      // clause landed NOBODY could remove live/state — not even the owner.
      // deleteMasterclass() in js/firebase.js has been attempting it (quietly,
      // outside the batch) since commit 3, and stopping a broadcast deletes it
      // too, so viewers see the class go off air. Two real callers, not tidying.
      allow delete: if mcIsOwner(mcId);
    }

    // ═════════════════════════ Students ═════════════════════════
    // A teacher follows a student's training. This is the first place in the
    // app where one person's PRIVATE progress becomes readable by someone
    // else, so consent is enforced here, not by the screen:
    //
    //   coaching/{teacherUid}_{studentUid}   the link — the teacher invites,
    //                                        ONLY the student can make it active
    //   studentReports/{studentUid}          the summary — written only by the
    //                                        student, readable only by the
    //                                        teachers listed in it, and it can
    //                                        only list teachers with an ACTIVE link
    //
    // Unlike Masterclass members (added by the owner with no yes from the
    // member), nothing here becomes readable without the student's own Accept.
    // Do not copy the addMembers() pattern into this block.
    //
    // Plan: docs/plans/2026-09-29-students.md, section 3.1.
    // Every clause here is covered by a test in tests/rules/students.test.js.

    function coachingPath(linkId) {
      return /databases/$(database)/documents/coaching/$(linkId);
    }

    // The friendship id for me and `other`: the two uids sorted and joined with
    // "_", exactly as pairIdOk() above requires, so the rule can compute it
    // without looking anything up.
    function friendPairWith(other) {
      return me() < other ? me() + '_' + other : other + '_' + me();
    }

    // Is there an ACTIVE link from teacher t to student s once THIS write (or
    // batch) has been applied? getAfter(), not get(), and that is the whole
    // point: accepting is ONE batch — the link goes pending → active AND the
    // first summary naming the teacher is written. get() sees the database
    // BEFORE the batch, where the link is still pending, so it would refuse the
    // very accept it exists for. Likewise "End" deletes a link and rewrites the
    // summary in one batch, and the remaining teachers are checked as they will
    // be afterwards.
    //
    // The two uid fields are checked as well as the id. Firebase uids contain
    // no "_", so "t_s" cannot really name somebody else's link — but checking
    // costs nothing (getAfter results are cached per path) and it means the
    // guarantee does not rest on that fact.
    //
    // When the link does not exist at all, the emulator makes getAfter() ERROR
    // ("Service call error") rather than return null, and an error denies —
    // the right answer. The `!= null` is kept so a runtime that returns null
    // instead still denies.
    function linkActiveAfter(t, s) {
      let link = getAfter(coachingPath(t + '_' + s));
      return link != null
        && link.data.status == 'active'
        && link.data.teacherUid == t
        && link.data.studentUid == s;
    }

    match /coaching/{linkId} {
      // Only the two people in the link can read it. .get(field, default), NOT
      // resource.data.teacherUid — the same trap documented on /friendRequests.
      // The app runs two list queries, "my students" (teacherUid == me) and "my
      // teachers" (studentUid == me). Each constrains ONE of the two fields, and
      // on a list query a field the query did not constrain does not exist, so
      // reading it directly errors and denies the whole query. Defaulting to ''
      // lets each query pass on the field it constrained, while a query that
      // constrains neither to my uid gets nothing.
      allow read: if signedIn()
        && (resource.data.get('teacherUid', '') == me()
            || resource.data.get('studentUid', '') == me());

      // Only the TEACHER creates a link, and only as 'pending'. It grants
      // nothing on its own: no summary can name this teacher until the student
      // flips it to 'active' (see linkActiveAfter above).
      allow create: if signedIn()
        && after().keys().hasOnly(['teacherUid', 'studentUid', 'status', 'createdAt'])
        && after().keys().hasAll(['teacherUid', 'studentUid', 'status', 'createdAt'])
        && after().teacherUid == me()
        && after().studentUid is string
        && after().studentUid.size() > 0 && after().studentUid.size() <= 128
        && after().studentUid != me()
        // Directional id, teacher first. NOT the sorted pair friendships use:
        // the two sides have different powers, so "who is the teacher" must be
        // readable from the id alone. It also makes a second invite to the same
        // person the same document — and a setDoc on an existing document is
        // an UPDATE, which the teacher is never allowed. So a pending invite
        // cannot be re-sent, and a declined one cannot be overwritten back to
        // pending.
        && linkId == me() + '_' + after().studentUid
        && after().status == 'pending'
        // serverTimestamp() on the client. A Date.now() number is refused.
        && after().createdAt == request.time
        // Friends only: you invite someone who already accepted YOU as a
        // friend. Friendships themselves need both sides' consent.
        && exists(/databases/$(database)/documents/friendships/$(friendPairWith(after().studentUid)))
        // Blocking is silent by design, exactly as on /friendRequests. A
        // blocked teacher gets a plain permission error and the app shows the
        // ordinary "Invite sent" toast. A block is never revealed.
        && !exists(/databases/$(database)/documents/blocks/$(after().studentUid)/blocked/$(me()));

      // Only the STUDENT answers, only once, and only pending → active or
      // pending → declined. Nothing else on the document may move: the diff
      // allows exactly the two answer fields. So an active link cannot be put
      // back to pending, a decline cannot be turned into an accept later, and
      // the teacher cannot accept on the student's behalf.
      allow update: if signedIn()
        && resource.data.studentUid == me()
        && resource.data.status == 'pending'
        && after().diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && after().status in ['active', 'declined']
        && after().respondedAt == request.time;

      // The student may delete in any state: that is "End", and also clearing
      // an old decline. The teacher may delete only 'pending' (withdraw the
      // invite) or 'active' (remove the student) — NOT 'declined'. Otherwise
      // delete + re-invite would let a teacher pester someone who said no. A
      // decline stays until the student clears it.
      allow delete: if signedIn()
        && (resource.data.studentUid == me()
            || (resource.data.teacherUid == me()
                && resource.data.status in ['pending', 'active']));
    }

    match /studentReports/{studentUid} {
      // The student, and the teachers the student listed. The teacher's
      // overview is one query, where('teachers','array-contains', me), which
      // this clause can prove from the query itself — no get(), no extra read.
      //
      // Known and accepted (plan 3.1): when a TEACHER removes a student, the
      // link is gone but the teacher cannot edit the student's summary, so they
      // stay listed until the student's app prunes them on its next publish
      // (the write rule below then refuses the old list). Until then the
      // removed teacher can still read it. That is the teacher removing
      // themselves, not a leak of anything the student did not agree to. There
      // is no server to do it sooner — do not try to "fix" it here.
      allow read: if signedIn()
        && (me() == studentUid || me() in resource.data.get('teachers', []));

      // Written ONLY by the student's own app. create and update share one
      // rule; after() is the whole resulting document either way.
      allow create, update: if signedIn()
        && me() == studentUid
        // The allowlist is the privacy promise. firstName, lastName,
        // dateOfBirth, email, games, bases and books are NOT here, so the
        // rules refuse them even from a buggy client — the same technique
        // /leaderboard uses. activeTime, hwOpen and hwDone are allowed from
        // stage 1 so stages 3 and 4 need no rules redeploy.
        && after().keys().hasOnly([
          'teachers', 'profileName', 'username', 'avatarId',
          'puzzleElo', 'blindfoldElo', 'openingEloAvg', 'endgameEloAvg',
          'puzzleThemeElo',
          'puzzleEloHistory', 'openingEloHistory', 'endgameEloHistory', 'blindfoldEloHistory',
          'puzzlesSolvedCount', 'puzzleAttemptCount', 'streakCount', 'bestStreak',
          'activeTime', 'hwOpen', 'hwDone', 'updatedAt'
        ])
        && after().updatedAt == request.time

        // THE CONSENT CHECK. At most 3 teachers — this is the enforced
        // 3-teacher cap — no duplicates, and EVERY one of them must have an
        // ACTIVE link to this student after this write. Three fixed index
        // checks because rules have no loops; each is skipped when the list is
        // shorter. So the summary physically cannot be shared with a teacher
        // whose invite the student did not accept.
        && after().teachers is list
        && after().teachers.size() <= 3
        && after().teachers.toSet().size() == after().teachers.size()
        && (after().teachers.size() < 1 || linkActiveAfter(after().teachers[0], studentUid))
        && (after().teachers.size() < 2 || linkActiveAfter(after().teachers[1], studentUid))
        && (after().teachers.size() < 3 || linkActiveAfter(after().teachers[2], studentUid))

        // Display text, bounded like /leaderboard so this cannot become free
        // storage.
        && (!('profileName' in after()) ||
            (after().profileName is string && after().profileName.size() <= 60))
        && (!('username' in after()) ||
            (after().username is string && after().username.size() <= 60))
        && (!('avatarId' in after()) ||
            (after().avatarId is string && after().avatarId.size() <= 64))

        // Ratings, range-checked to reject impossible values.
        && (!('puzzleElo' in after())     || num(after().puzzleElo, 0, 4000))
        && (!('blindfoldElo' in after())  || num(after().blindfoldElo, 0, 4000))
        && (!('openingEloAvg' in after()) || num(after().openingEloAvg, 0, 4000))
        && (!('endgameEloAvg' in after()) || num(after().endgameEloAvg, 0, 4000))
        // Maps get a key-count bound (the rules auditor's finding): without
        // one, a tampered client could grow its summary toward the 1 MB cap and
        // every teacher would download it. Keys are Lichess puzzle themes
        // (about 70 exist), so 200 is headroom, not a squeeze.
        && (!('puzzleThemeElo' in after()) ||
            (after().puzzleThemeElo is map && after().puzzleThemeElo.size() <= 200))

        // Rating histories: the client sends the last 120 {date, value}
        // entries (the device keeps 400). The size cap is what matters here;
        // the entries themselves cannot be shape-checked (rules have no loops),
        // which is accepted — this document is the student's own and only the
        // teachers they accepted can read it.
        && (!('puzzleEloHistory' in after()) ||
            (after().puzzleEloHistory is list && after().puzzleEloHistory.size() <= 120))
        && (!('openingEloHistory' in after()) ||
            (after().openingEloHistory is list && after().openingEloHistory.size() <= 120))
        && (!('endgameEloHistory' in after()) ||
            (after().endgameEloHistory is list && after().endgameEloHistory.size() <= 120))
        && (!('blindfoldEloHistory' in after()) ||
            (after().blindfoldEloHistory is list && after().blindfoldEloHistory.size() <= 120))

        // Counters.
        && (!('puzzlesSolvedCount' in after()) || num(after().puzzlesSolvedCount, 0, 1000000))
        && (!('puzzleAttemptCount' in after()) || num(after().puzzleAttemptCount, 0, 10000000))
        && (!('streakCount' in after())        || num(after().streakCount, 0, 30000))
        && (!('bestStreak' in after())         || num(after().bestStreak, 0, 30000))

        // Stage 3 and 4 fields, shape-checked now so they need no redeploy.
        // activeTime is {date: {area: seconds}} for the last 30 days, so at
        // most 31 day keys.
        && (!('activeTime' in after()) ||
            (after().activeTime is map && after().activeTime.size() <= 31))
        && (!('hwOpen' in after()) || num(after().hwOpen, 0, 1000))
        && (!('hwDone' in after()) || num(after().hwDone, 0, 1000));

      // Only the student. This is what "End" does when the last teacher goes.
      allow delete: if signedIn() && me() == studentUid;
    }

    // ── Homework (stage 4) ──────────────────────────────────────────
    //   homework/{autoId}   one task from a teacher to a student. The teacher
    //                       writes it once; after that only the STUDENT's app
    //                       moves it, and only its progress fields.
    //
    // Four kinds: 'puzzles' (N puzzles of a theme set and rating band) and
    // 'text' (the student ticks it off) since stage 4; 'chapter' (one chapter of
    // a Masterclass the teacher OWNS) and 'list' (≤ 20 hand-picked puzzles,
    // stored whole so the student never has to find them) since stage 5.
    //
    // Progress is reported by the student's own phone (plan Part 1, point 2):
    // these clauses reject impossible values, they cannot prove the puzzles
    // were really solved. There is no server to check that.

    // The task itself: a closed set of fields per kind, each bounded. Rules have
    // no loops, so the ≤ 5 theme ids get five fixed index checks.
    function hwThemeOk(list, i) {
      return list.size() <= i || (list[i] is string && list[i].size() >= 1 && list[i].size() <= 40);
    }
    function hwParamsOk(d) {
      return (d.kind == 'text' && d.params is map && d.params.size() == 0)
        || (d.kind == 'puzzles' && d.params is map
            && d.params.keys().hasOnly(['themes', 'minRating', 'maxRating', 'count'])
            && d.params.keys().hasAll(['themes', 'minRating', 'maxRating', 'count'])
            // An empty list means "any theme" — a rating band on its own.
            && d.params.themes is list && d.params.themes.size() <= 5
            && hwThemeOk(d.params.themes, 0) && hwThemeOk(d.params.themes, 1)
            && hwThemeOk(d.params.themes, 2) && hwThemeOk(d.params.themes, 3)
            && hwThemeOk(d.params.themes, 4)
            && d.params.minRating is int && d.params.maxRating is int
            && d.params.minRating >= 0 && d.params.maxRating <= 4000
            && d.params.minRating <= d.params.maxRating
            && d.params.count is int && d.params.count >= 1 && d.params.count <= 100)
        || (d.kind == 'chapter' && d.params is map
            && d.params.keys().hasOnly(['mcId', 'chapterId'])
            && d.params.keys().hasAll(['mcId', 'chapterId'])
            // Document-id characters only: both go into get()/exists() paths
            // below, where a '/' would change which document is looked up.
            && d.params.mcId is string && d.params.mcId.matches('[A-Za-z0-9_-]{1,128}')
            && d.params.chapterId is string && d.params.chapterId.matches('[A-Za-z0-9_-]{1,128}'))
        || (d.kind == 'list' && d.params is map
            && d.params.keys().hasOnly(['puzzles'])
            && hwListOk(d.params.puzzles));
    }

    // ≤ 20 packed puzzles (hwPzOk below), walked with fixed indexes because
    // rules have no loops.
    function hwListOk(ps) {
      return ps is list && ps.size() >= 1 && ps.size() <= 20
        && hwPzOk(ps, 0) && hwPzOk(ps, 1) && hwPzOk(ps, 2) && hwPzOk(ps, 3)
        && hwPzOk(ps, 4) && hwPzOk(ps, 5) && hwPzOk(ps, 6) && hwPzOk(ps, 7)
        && hwPzOk(ps, 8) && hwPzOk(ps, 9) && hwPzOk(ps, 10) && hwPzOk(ps, 11)
        && hwPzOk(ps, 12) && hwPzOk(ps, 13) && hwPzOk(ps, 14) && hwPzOk(ps, 15)
        && hwPzOk(ps, 16) && hwPzOk(ps, 17) && hwPzOk(ps, 18) && hwPzOk(ps, 19);
    }

    // One puzzle of a 'list', PACKED into one string the app builds and reads
    // (js/firebase.js packPuzzle / unpackPuzzle):
    //     id|fen|move move move|rating|theme theme
    // Why not a map {id, fen, moves, rating, themes}: a write may evaluate at
    // most 1,000 expressions, and every field read of a list element costs
    // about a dozen — measured in the emulator, a map with its five fields
    // checked broke the limit at FIVE puzzles. One regex is two reads per
    // puzzle, so 20 fit, and it is stricter than the map ever could be: every
    // move must be UCI and every theme a short word, which a map check could
    // only have bounded by count.
    function hwPzOk(list, i) {
      return list.size() <= i || (list[i] is string && list[i].matches(
        '[A-Za-z0-9_-]{1,40}[|]'
        + '[1-8pnbrqkPNBRQK/]{15,71} [wb] [-KQkq]{1,4} [-a-h1-8]{1,2} [0-9]{1,3} [0-9]{1,4}[|]'
        + '[a-h][1-8][a-h][1-8][qrbn]?( [a-h][1-8][a-h][1-8][qrbn]?){0,39}[|]'
        + '(4000|[0-3]?[0-9]{1,3})[|]'
        + '([A-Za-z0-9]{1,40}( [A-Za-z0-9]{1,40}){0,19})?'));
    }

    // A chapter task may only point at a chapter that exists, in a class the
    // teacher OWNS — the class the app adds the student to (only an owner can
    // add members). Other kinds cost no read here: `||` stops early.
    function hwChapterOk(d) {
      return d.kind != 'chapter'
        || (get(mcPath(d.params.mcId)).data.ownerUid == me()
            && exists(/databases/$(database)/documents/masterclasses/$(d.params.mcId)/chapters/$(d.params.chapterId)));
    }

    // Which puzzles of a 'list' are solved: ids only, ≤ 20, each a short string.
    function hwIdOk(list, i) {
      return list.size() <= i || (list[i] is string && list[i].size() >= 1 && list[i].size() <= 40);
    }
    function hwDoneIdsOk(ids) {
      return ids is list && ids.size() <= 20
        && hwIdOk(ids, 0) && hwIdOk(ids, 1) && hwIdOk(ids, 2) && hwIdOk(ids, 3)
        && hwIdOk(ids, 4) && hwIdOk(ids, 5) && hwIdOk(ids, 6) && hwIdOk(ids, 7)
        && hwIdOk(ids, 8) && hwIdOk(ids, 9) && hwIdOk(ids, 10) && hwIdOk(ids, 11)
        && hwIdOk(ids, 12) && hwIdOk(ids, 13) && hwIdOk(ids, 14) && hwIdOk(ids, 15)
        && hwIdOk(ids, 16) && hwIdOk(ids, 17) && hwIdOk(ids, 18) && hwIdOk(ids, 19);
    }

    // What `done` counts up to: the puzzle count, the length of a list, or 1
    // for a text task or a chapter.
    function hwTargetOk(d, n) {
      return (d.kind == 'puzzles' && n <= d.params.count)
        || (d.kind == 'list' && n <= d.params.puzzles.size())
        || (d.kind in ['text', 'chapter'] && n <= 1);
    }
    // …and 'done' only once it is reached exactly (the rules auditor's
    // finding: without this a text task could be 'done' with done == 0).
    function hwTargetReached(d, n) {
      return (d.kind == 'puzzles' && n == d.params.count)
        || (d.kind == 'list' && n == d.params.puzzles.size())
        || (d.kind in ['text', 'chapter'] && n == 1);
    }

    match /homework/{hwId} {
      // The two people it names. .get(field, default) for the same reason as
      // /coaching: the student lists "studentUid == me", the teacher lists
      // "teacherUid == me AND studentUid == X", and a field a query did not
      // constrain must not error the whole query.
      allow read: if signedIn()
        && (resource.data.get('teacherUid', '') == me()
            || resource.data.get('studentUid', '') == me());

      // Only a teacher, and only for somebody who currently ACCEPTS them: the
      // link must be 'active' right now. get(), not getAfter() — nothing is
      // batched with a create, and a pending/declined/missing link must refuse.
      // (get() of a missing document errors, and an error denies.)
      // Everything starts at zero; progress belongs to the student.
      allow create: if signedIn()
        && after().keys().hasOnly(['teacherUid', 'studentUid', 'kind', 'title', 'note',
                                   'params', 'dueDate', 'status', 'done', 'seconds', 'createdAt'])
        && after().keys().hasAll(['teacherUid', 'studentUid', 'kind', 'title',
                                  'params', 'status', 'done', 'seconds', 'createdAt'])
        && after().teacherUid == me()
        && after().studentUid is string
        && after().studentUid.size() > 0 && after().studentUid.size() <= 128
        && after().studentUid != me()
        && get(coachingPath(me() + '_' + after().studentUid)).data.status == 'active'
        && after().kind in ['puzzles', 'text', 'chapter', 'list']
        && after().title is string && after().title.size() >= 1 && after().title.size() <= 80
        && (!('note' in after()) || (after().note is string && after().note.size() <= 500))
        && (!('dueDate' in after())
            || (after().dueDate is string && after().dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && hwParamsOk(after())
        && hwChapterOk(after())
        && after().status == 'open'
        && after().done == 0
        && after().seconds == 0
        && after().createdAt == request.time;

      // Only the STUDENT, and only the progress fields: the diff allows
      // done / seconds / status / completedAt and nothing else, so the task
      // (kind, title, count, band, who) can never be edited — the teacher
      // deletes and re-creates instead. Counters only go up (the app sends
      // increment(), so two phones add up instead of overwriting), `done` never
      // passes the target, and time is capped at 100 hours. 'done' is final:
      // it cannot be reopened, and a task can only be 'done' once its target
      // is reached (count for puzzles, list length, 1 for text and chapter).
      // completedAt is stamped by the server exactly once, on the move to 'done'.
      //
      // doneIds (stage 5) is which puzzles of a 'list' are solved. Only a list
      // may carry it; it only grows (the app sends arrayUnion()), never past
      // the list's length. It is deliberately NOT tied to `done` by an
      // equality: two phones solving the same puzzle would make an honest
      // bundle fail and lose its seconds, and a self-reported counter proves
      // nothing either way (plan Part 1, point 2).
      allow update: if signedIn()
        && resource.data.studentUid == me()
        && after().diff(resource.data).affectedKeys().hasOnly(['done', 'seconds', 'status', 'completedAt', 'doneIds'])
        // Keyed on the DIFF, not on presence: deleting the field (deleteField())
        // lands in the checks below and errors, so it cannot shrink that way
        // either (rules auditor, stage 5).
        && (!('doneIds' in after().diff(resource.data).affectedKeys())
            || (resource.data.kind == 'list'
                && hwDoneIdsOk(after().doneIds)
                && after().doneIds.size() <= resource.data.params.puzzles.size()
                && after().doneIds.hasAll(resource.data.get('doneIds', []))))
        && after().done is int && after().done >= resource.data.done
        && hwTargetOk(resource.data, after().done)
        && after().seconds is int && after().seconds >= resource.data.seconds
        && after().seconds <= 360000
        && after().status in ['open', 'done']
        && (resource.data.status == 'open' || after().status == 'done')
        && (after().status == 'open' || hwTargetReached(resource.data, after().done))
        && ((after().status == resource.data.status
             && !('completedAt' in after().diff(resource.data).affectedKeys()))
            || (after().status != resource.data.status
                && after().completedAt == request.time));

      // The teacher, always (withdrawing a task, removing a student, deleting
      // an account). The student only once the link is no longer active —
      // getAfter()/existsAfter(), so "End" can delete the link AND this
      // teacher's homework in ONE batch. existsAfter() first: getAfter() on a
      // deleted link errors, and an error would deny the tidy-up.
      allow delete: if signedIn()
        && (resource.data.teacherUid == me()
            || (resource.data.studentUid == me()
                && (!existsAfter(coachingPath(resource.data.teacherUid + '_' + me()))
                    || getAfter(coachingPath(resource.data.teacherUid + '_' + me())).data.status != 'active')));
    }
  }
}
