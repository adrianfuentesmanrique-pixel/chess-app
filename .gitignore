node_modules/
*.log

# Working notes, not part of the product. This repo is served by GitHub Pages,
# so anything committed here is publicly readable at the site root.
DESIGN-AUDIT-PROMPT.md

# Incoming artwork that the app doesn't reference yet. Kept out until the
# final files are ready — git history is permanent, so there is no cheap way
# to un-commit several MB of images that end up being replaced.
icons/Streak Flames/

# Generated by graphify (/graphify .) — a large machine-generated map of the
# codebase. Rebuildable at any time, so there is no reason to commit it.
graphify-out/

# Real secrets. This repo is public and served by GitHub Pages, so anything
# committed here is world-readable and stays in git history even if deleted.
# The Firebase web config in js/firebase.js is NOT a secret and belongs in the
# repo — it identifies the project, it does not grant access. These do grant it:
*.jks
*.keystore
*.p12
*.pem
*.key
.env
.env.*
**/service-account*.json
**/serviceAccountKey*.json
google-services.json
android/keystore.properties

# Python bytecode from tools/
__pycache__/
*.pyc
